#!/bin/bash
#version 0.97-N/HS-I modded for Unisoc UWE5622
# Based on RaspberryConnect.com auto-hotspot
# Modified: skip WiFi scan on UWE5622 (firmware crashes on iw scan)

# You may share this script on the condition a reference to RaspberryConnect.com
# must be included in copies or derivatives of this script.

wifidev="wlan0"
ethdev="eth0"

createAdHocNetwork()
{
    echo "Creating Hotspot"
    # Prevent NetworkManager from reclaiming wlan0
    if command -v nmcli >/dev/null 2>&1; then
        nmcli device set "$wifidev" managed no 2>/dev/null
    fi
    ip link set dev "$wifidev" down
    ip a add 192.168.50.1/24 brd + dev "$wifidev"
    ip link set dev "$wifidev" up
    dhcpcd -k "$wifidev" >/dev/null 2>&1
    # Wait for interface to be ready before starting dnsmasq
    sleep 1
    if iptables 2>&1 | grep 'no command specified' ; then
        iptables -t nat -A POSTROUTING -o "$ethdev" -j MASQUERADE
    fi
    systemctl start dnsmasq
    systemctl start hostapd
    dhcpcd -n "$wifidev" >/dev/null 2>&1
    echo 1 > /proc/sys/net/ipv4/ip_forward
}

KillHotspot()
{
    echo "Shutting Down Hotspot"
    ip link set dev "$wifidev" down
    systemctl stop hostapd
    systemctl stop dnsmasq
    if iptables 2>&1 | grep 'no command specified' ; then
        iptables -t nat -D POSTROUTING -o "$ethdev" -j MASQUERADE 2>/dev/null
    fi
    echo 0 > /proc/sys/net/ipv4/ip_forward
    ip addr flush dev "$wifidev"
    ip link set dev "$wifidev" up
    # Re-enable NetworkManager management of wlan0
    if command -v nmcli >/dev/null 2>&1; then
        nmcli device set "$wifidev" managed yes 2>/dev/null
    fi
    dhcpcd -n "$wifidev" >/dev/null 2>&1
}

chksys()
{
    # Ensure hostapd and dnsmasq are unmasked and disabled (started on demand)
    if systemctl -all list-unit-files hostapd.service | grep "hostapd.service masked" >/dev/null 2>&1; then
        systemctl unmask hostapd.service >/dev/null 2>&1
    fi
    if systemctl -all list-unit-files hostapd.service | grep "hostapd.service enabled" >/dev/null 2>&1; then
        systemctl disable hostapd.service >/dev/null 2>&1
        systemctl stop hostapd >/dev/null 2>&1
    fi
    if systemctl -all list-unit-files dnsmasq.service | grep "dnsmasq.service masked" >/dev/null 2>&1; then
        systemctl unmask dnsmasq >/dev/null 2>&1
    fi
    if systemctl -all list-unit-files dnsmasq.service | grep "dnsmasq.service enabled" >/dev/null 2>&1; then
        systemctl disable dnsmasq >/dev/null 2>&1
        systemctl stop dnsmasq >/dev/null 2>&1
    fi
}

chksys

# Check for configured WiFi: NM profiles or wpa_supplicant.conf
# (Skip iw scan - UWE5622 firmware crashes on scan commands)
has_wifi=false
if command -v nmcli >/dev/null 2>&1; then
    wifi_profiles=$(nmcli -t -f TYPE,NAME connection show 2>/dev/null | grep "^802-11-wireless:" | head -1)
    if [ -n "$wifi_profiles" ]; then
        has_wifi=true
    fi
fi
if [ "$has_wifi" = false ]; then
    wpassid=$(awk '/ssid="/{ print $0 }' /etc/wpa_supplicant/wpa_supplicant.conf 2>/dev/null | head -1)
    if [ -n "$wpassid" ]; then
        has_wifi=true
    fi
fi

if [ "$has_wifi" = false ]; then
    echo "No configured WiFi networks, creating hotspot"
    createAdHocNetwork
else
    # WiFi networks configured - try to connect via NetworkManager
    echo "Configured WiFi found, attempting connection"
    if command -v nmcli >/dev/null 2>&1; then
        nmcli device set "$wifidev" managed yes 2>/dev/null
        sleep 20
        if nmcli -t -f GENERAL.STATE device show "$wifidev" 2>/dev/null | grep -q "connected"; then
            echo "WiFi connected via NetworkManager"
        else
            echo "WiFi connection failed, falling back to hotspot"
            createAdHocNetwork
        fi
    else
        wpa_supplicant -B -i "$wifidev" -c /etc/wpa_supplicant/wpa_supplicant.conf >/dev/null 2>&1
        sleep 20
        if wpa_cli -i "$wifidev" status 2>/dev/null | grep 'ip_address' >/dev/null 2>&1; then
            echo "WiFi connected"
        else
            echo "WiFi failed, creating hotspot"
            wpa_cli terminate >/dev/null 2>&1
            createAdHocNetwork
        fi
    fi
fi
